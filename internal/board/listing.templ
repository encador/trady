package board

import (
	"github.com/encador/trady/internal/items"
	"github.com/encador/trady/internal/models"
)

templ Board(listings []models.Item) {
	<div id="item-list">
		@items.ItemCSS()
		for _, listing := range listings {
			@items.Item(listing)
		}
	</div>
	<style>
		#item-list {
			display: flex;
			flex-wrap: wrap;
			padding: 15px;
			/* align-items: center; */
			justify-content: center;
			box-sizing: border-box;
			margin: 0;
			/* width: 100%; */
			/* height: 100%; */
			max-width: 100%;
			max-height: 100%;
			min-width: auto;
			min-height: auto;

			overflow: auto;
		}
	</style>
}
